{
  "mcpServers": {
    "stata-local": {
      "command": "C:/path/to/stata-mcp/.venv/Scripts/python.exe",
      "args": ["-m", "stata_mcp"],
      "env": {
        "STATA_HOME": "C:/Program Files/StataNow19",
        "STATA_EDITION": "be",
        "STATA_WORKDIR": "C:/path/to/stata-analysis",
        "STATA_TIMEOUT": "120",
        "PYTHONUTF8": "1"
      }
    }
  }
}
